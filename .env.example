# Rails / PostgreSQL (this database is deliberately distinct from the retired Java database)
RAILS_ENV=development
RAILS_MAX_THREADS=5
DATABASE_URL=postgresql://anabuki:anabuki@localhost:5433/anabuki_event_rails_development
PORT=8080
QUE_WORKER_COUNT=3

# Active Record Encryption. Development/test have safe local defaults; set
# your own values for data that must survive a local restart. Production
# requires all three values from the deployment secret store.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Public origins and Google OAuth callback
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000/admin
OPERATOR_FRONTEND_URL=http://localhost:3000/operator
# Extra allowed origins, comma-separated (no spaces needed, they are trimmed).
# Use this to add LAN IPs when the frontend dev server is reached from other
# devices (e.g. participants' phones during the event) in addition to the
# single PUBLIC_BASE_URL/ADMIN_FRONTEND_URL/OPERATOR_FRONTEND_URL above.
# Example: ADDITIONAL_ALLOWED_ORIGINS=http://192.168.1.50:3000,http://192.168.1.51:3000
ADDITIONAL_ALLOWED_ORIGINS=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
OPERATOR_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/operator/google/callback

# Google OAuth (put real values only in an untracked .env or deployment secret store)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Individual email addresses only, comma-separated. Re-evaluated on each request.
ADMIN_EMAIL_ALLOWLIST=your-email@example.com
OPERATOR_EMAIL_ALLOWLIST=operator-email@example.com

# Admin API status integrations. Keep all real provider keys only in an untracked
# .env or deployment secret store. Leaving an integration unset returns an
# explicit `unconfigured` status to the management UI; it never means healthy.
# Statuspage: set the public summary URL OR the authenticated Page ID/API key.
STATUSPAGE_PUBLIC_SUMMARY_URL=
STATUSPAGE_PAGE_ID=
STATUSPAGE_API_KEY=
STATUSPAGE_API_BASE_URL=https://api.statuspage.io/v1
# Datadog uses the v2 Metrics API. Each query must return the displayed unit:
# error rate in percent and response time in milliseconds.
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_API_BASE_URL=
DATADOG_ERROR_RATE_QUERY=
DATADOG_RESPONSE_TIME_QUERY=
DATADOG_METRICS_WINDOW_SECONDS=300
# Server-side cache lifetime (0 disables caching; allowed range is 0-300).
API_STATUS_CACHE_TTL_SECONDS=60

# Cloudflare R2 / Active Storage (production only; never commit real credentials)
ACTIVE_STORAGE_SERVICE=local
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=anabuki-event-images
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Sentry is optional locally. Never commit a real DSN or release secret.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_ENABLED_ENVIRONMENTS=production

# Required in production; generate with `bin/rails secret` and store outside Git.
SECRET_KEY_BASE=
